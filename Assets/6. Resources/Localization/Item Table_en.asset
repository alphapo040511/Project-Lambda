  m_TableData:
  - m_Id: 6261805056
    m_Localized: A damaged fuse. The reason why it is broken is unknown.
    m_Metadata:
      m_Items: []
  - m_Id: 368217657344
    m_Localized: A fuse used in the <color=#FFD700>power control room</color>. Inserting
      it into the fuse box will restore power.
    m_Metadata:
      m_Items: []
  - m_Id: 370625187840
    m_Localized: A key that can unlock the padlock attached to the <color=#FFD700>fuse
      box</color>.
    m_Metadata:
      m_Items: []
  - m_Id: 372315492352
    m_Localized: A key that can unlock one of the padlocks attached to the <color=#FFD700>fuse
      storage locker</color>.
    m_Metadata:
      m_Items: []
  - m_Id: 374374895616
    m_Localized: A terminal used by general researchers. It has <color=#00E5FF>level
      1 access authority</color>.
    m_Metadata:
      m_Items: []
  - m_Id: 435020337152
    m_Localized: A terminal granted the <color=#00E5FF>highest level of access</color>
      by solving the word puzzle. It can control all systems in the facility.
    m_Metadata:
      m_Items: []
  - m_Id: 433548136448
    m_Localized: A terminal granted <color=#00E5FF>level 2 access</color> by solving
      the pipe puzzle.
    m_Metadata:
      m_Items: []
