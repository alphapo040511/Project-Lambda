--- !u!114 &1352780549
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1352780548}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83f2271cd3ef62f4fa9f190a2e592784, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogues:
  - index: AI_Hologram_Reconstruct
    clip: {fileID: 8300000, guid: ff8286c73f96f6d4ca9b5641e6f7c864, type: 3}
    text: "\uAC10\uC2DC \uAE30\uB85D\uC744 \uBD84\uC11D \uC911\uC785\uB2C8\uB2E4.
      \uC2DC\uAC01\uD654\uB41C \uC7A5\uBA74\uC744 \uC7AC\uAD6C\uC131\uD558\uC5EC
      \uD45C\uC2DC\uD569\uB2C8\uB2E4."
  - index: AI_Door_Open
    clip: {fileID: 8300000, guid: 1ee2adb15a4b72f418080baa903d2438, type: 3}
    text: "\uBCF4\uC548 \uD504\uB85C\uD1A0\uCF5C \uD574\uC81C \uC644\uB8CC. \uBB38\uC774
      \uC5F4\uB9BD\uB2C8\uB2E4."
  - index: AI_HibernationWake_001
    clip: {fileID: 8300000, guid: 273f53e0eca221e4dbf58dfbc27eeb21, type: 3}
    text: "\uB3D9\uBA74 \uBAA8\uB4C8 \uD65C\uC131\uD654. \uC2DC\uC2A4\uD15C \uC810\uAC80
      \uC2DC\uC791."
  - index: AI_HibernationWake_002
    clip: {fileID: 8300000, guid: 62634604f161c18458cf8da499f38e9c, type: 3}
    text: "\uBD80\uB3D9\uC561 \uC81C\uAC70 \uC644\uB8CC. \uD608\uC561 \uC21C\uD658
      \uC815\uC0C1\uD654."
  - index: AI_HibernationWake_003
    clip: {fileID: 8300000, guid: 1e050c934cf011b4a805da669d010bb7, type: 3}
    text: "\uC2EC\uBC15\uC218 \uC548\uC815\uD654 \uC644\uB8CC. \uC0B0\uC18C \uB18D\uB3C4
      \uC815\uC0C1."
  - index: AI_HibernationWake_004
    clip: {fileID: 8300000, guid: 1676d74d5909b2148ac81ff7ff8d1cdb, type: 3}
    text: "\uADFC\uC721 \uBC0F \uC2E0\uACBD \uC815\uC0C1 \uAE30\uB2A5."
  - index: AI_HibernationWake_005
    clip: {fileID: 8300000, guid: e08a8cb521e61a44b922760140bf59a6, type: 3}
    text: "\uB3D9\uBA74 \uD574\uC81C \uC644\uB8CC. \uD658\uC601\uD569\uB2C8\uB2E4."
  audioMixer: {fileID: -1458014019941555398, guid: 05fa863b6ea095d41842411818003e6b,
    type: 2}
